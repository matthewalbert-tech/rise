<?Template languageVersion="1.2" ?>
<Card title="Rise.ai Wallet">
  <CurrencyValue dataSource="balance" label="Store Credit" />
  <StringValue when="loyaltyCardNumber is defined" dataSource="loyaltyCardNumber" label="Loyalty Card No." />

  <Drawer when="transactions is not empty">
    <Fixed>
      <Text>Transaction History ({{ transactions|length }})</Text>
    </Fixed>
    <Expandable>
      <List dataSource="transactions" separateItems="true">
        <ColumnGroup columnSpacing="medium">
          <Column width="stretch">
            <Formula valueFontWeight="medium">{{ type | title }}</Formula>
            <DateTimeValue dataSource="createdAt" format="MMM D, YYYY" />
            <StringValue when="note is not empty" dataSource="note" />
          </Column>
          <Column width="30%" verticalAlignment="middle">
            <CurrencyValue dataSource="amount" valueAlignment="right" />
          </Column>
        </ColumnGroup>
      </List>
    </Expandable>
  </Drawer>
</Card>
